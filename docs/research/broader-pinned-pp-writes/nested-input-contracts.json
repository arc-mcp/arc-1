            "type": "string"
          }
        },
        "required": [
          "uri"
        ]
      }
    },
    "SAPDiagnose.filters": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attribute": {
            "type": "string",
            "maxLength": 40
          },
          "operator": {
            "type": "string",
            "maxLength": 40
          },
          "values": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "required": [
          "attribute",
          "operator",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "SAPLint.rules": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
