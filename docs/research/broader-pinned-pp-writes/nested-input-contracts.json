{
  "common": {
    "SAPWrite.fixedValues": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "low": {
            "type": "string",
            "maxLength": 10
          },
          "high": {
            "type": "string",
            "maxLength": 10
          },
          "description": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "low"
        ]
      }
    },
    "SAPWrite.messages": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "shortText": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "shortText"
        ]
      }
    },
    "SAPWrite.shortTexts": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "node",
          "text"
        ]
      }
    },
    "SAPWrite.parameters": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "importing",
              "exporting",
              "changing",
              "tables",
              "exceptions",
              "raising"
