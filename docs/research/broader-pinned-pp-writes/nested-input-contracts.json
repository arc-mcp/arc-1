          "searchHelp": {
            "type": "string"
          },
          "searchHelpParameter": {
            "type": "string"
          },
          "setGetParameter": {
            "type": "string"
          },
          "defaultComponentName": {
            "type": "string"
          },
          "deactivateInputHistory": {
            "type": "boolean"
          },
          "changeDocument": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string"
                },
                "shortText": {
                  "type": "string"
                }
              },
              "required": [
                "number",
                "shortText"
              ]
            }
          },
          "serviceDefinition": {
            "type": "string"
          },
          "bindingType": {
            "type": "string"
          },
          "odataVersion": {
            "type": "string",
            "enum": [
              "V2",
              "V4"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "0",
              "1"
            ]
          },
          "version": {
            "type": "string"
          },
          "processingType": {
            "type": "string",
            "enum": [
              "normal",
              "rfc",
              "update"
            ]
          },
          "updateTaskKind": {
            "type": "string",
            "enum": [
              "startImmediate",
              "immediateStartNoRestart",
              "startDelayed"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "importing",
                    "exporting",
                    "changing",
                    "tables",
                    "exceptions",
                    "raising"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "type": {
                  "type": "string"
                },
                "byValue": {
                  "type": "boolean"
                },
                "default": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "name"
              ]
            }
          }
        },
        "required": [
          "type",
          "name"
        ]
      }
    },
    "SAPDiagnose.objects": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CLAS",
              "INTF",
              "PROG",
              "FUGR",
              "DDLS",
              "DCLS",
              "BDEF",
              "DDLX",
              "SRVD",
              "SRVB",
              "TABL",
              "DTEL",
              "DOMA"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^(?:\\/[A-Za-z0-9_]+\\/)?[A-Za-z0-9_]+$"
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
