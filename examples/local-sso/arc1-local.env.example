# Copy to arc1-local.env (same folder as compose.yaml). Do not commit the copy.
SAP_URL=https://sap-host.example.com:44300
SAP_USER=REPLACE_ME
SAP_PASSWORD=REPLACE_ME
SAP_CLIENT=100
SAP_LANGUAGE=EN
# SAP_INSECURE=true   # only for a self-signed SAP certificate on a personal test system
# Admin API key for yourself (generate with: openssl rand -hex 32). Format is key:profile.
ARC1_API_KEYS=REPLACE_ME_64_HEX_CHARS:admin
