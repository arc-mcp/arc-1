# Optional overlay AFTER the conservative multi-PP profile, not a standalone profile.
# Prepare roles unassigned; activate/verify enforcement before assigning restricted users.
# Existing deployments keep supported standard access (standard) unless the operator opts in.
# No independent single-target /mcp may coexist when enforcement is enabled.
_schema-version: "3.1"
ID: arc1-multi-pp-target-authorization-example
extends: arc1-multi-pp-example
modules:
  - name: arc1-mcp-server
    properties:
      ARC1_MULTI_TARGET_AUTHORIZATION: xsuaa-attribute
