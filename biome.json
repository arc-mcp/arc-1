{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noAssignInExpressions": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "bin/**",
      "scripts/smoke-live-relations.ts",
      "scripts/smoke-ddic-extensions.ts",
      "scripts/smoke-source-plugins.ts",
      "scripts/smoke-ddic-extensions-btp.ts",
      "scripts/bench-context-parsing.ts",
      "scripts/spikes/pr677-target-authorization/**",
      "scripts/spikes/stxl/**",
      "scripts/ci/check-target-authorization-mta.mjs",
      "!tests/fixtures/tool-definitions"
    ]
  }
}
