rey;"&gt;1&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;2&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;3&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;4&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;5&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;6&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;7&lt;/span&gt;&lt;span class="linenumber"&gt;&lt;a title="Show Abortion in Code" href="adt://NPL/sap/bc/adt/programs/programs/zarc1_e2e_dump/source/main#start=8"&gt;&lt;span class="indicator"&gt;&gt;&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;&lt;span class="linenumber style="color:grey;"&gt;9&lt;/span&gt;&lt;/td&gt;&lt;td id="sourcetablecolumn"&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="keyword"&gt;REPORT&lt;/span&gt; zarc1_e2e_dump&lt;span class="keyword"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="comment"&gt;* ARC-1 E2E diagnostics dump fixture.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="keyword"&gt;DATA&lt;/span&gt; lv_zero &lt;span class="keyword"&gt;TYPE&lt;/span&gt; i &lt;span class="keyword"&gt;VALUE&lt;/span&gt; &lt;span class="number"&gt;0&lt;/span&gt;&lt;span class="keyword"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="keyword"&gt;DATA&lt;/span&gt; lv_result &lt;span class="keyword"&gt;TYPE&lt;/span&gt; i&lt;span class="keyword"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="keyword"&gt;IF&lt;/span&gt; lv_zero &lt;span class="keyword"&gt;&amp;lt;&lt;/span&gt; &lt;span class="number"&gt;1&lt;/span&gt;&lt;span class="keyword"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&lt;span class="comment"&gt;" &amp;lt;intentional&amp;gt; &amp;amp; documented&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="sourceline highlight"&gt;&lt;a title="Show Abortion in Code" href="adt://NPL/sap/bc/adt/programs/programs/zarc1_e2e_dump/source/main#start=8" style="text-decoration:none;"&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;lv_result &lt;span class="keyword"&gt;=&lt;/span&gt; &lt;span class="number"&gt;1&lt;/span&gt; &lt;span class="keyword"&gt;/&lt;/span&gt; lv_zero&lt;span class="keyword"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class="sourceline"&gt;&lt;span&gt;&lt;span class="keyword"&gt;ENDIF.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;h4 id="STACK"&gt;Active Calls/Events&lt;/h4&gt;&lt;style&gt;code { font-family: Consolas, "Liberation Mono", Courier, monospace; }&lt;/style&gt;&lt;table cellspacing="5"&gt;&lt;tr&gt;&lt;th align="left"&gt;No.&lt;/th&gt;&lt;th align="left"&gt;Event&lt;/th&gt;&lt;th align="left"&gt;Program&lt;/th&gt;&lt;th align="left"&gt;Include&lt;/th&gt;&lt;th align="left"&gt;Line&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;&lt;a href="adt://NPL/sap/bc/adt/programs/programs/zarc1_e2e_dump/source/main#start=8"&gt;1&lt;/a&gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;START-OF-SELECTION&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;ZARC1_E2E_DUMP&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;ZARC1_E2E_DUMP&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;8&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</atom:summary><atom:title>Division by zero.</atom:title><atom:updated>2026-10-24T07:21:05Z</atom:updated></atom:entry></atom:feed>
