/adt/vit/runtime/dumps/20261024092105vhcalnplci_NPL_00%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20DEVELOPER%20%20%20001%20%20%20%20%20%20%2012</atom:id><atom:link href="adt://NPL/sap/bc/adt/vit/runtime/dumps/20261024092105vhcalnplci_NPL_00%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20DEVELOPER%20%20%20001%20%20%20%20%20%20%2012" rel="alternate" type="application/vnd.sap.adt.sapgui"/><atom:published>2026-10-24T07:21:05Z</atom:published><atom:summary type="html">&lt;p style="text-align:right;font-size:10px"&gt;&lt;a href="adt://NPL/sap/bc/adt/vit/runtime/dumps/20261024092105vhcalnplci_NPL_00%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20DEVELOPER%20%20%20001%20%20%20%20%20%20%2012"&gt;Show in SAP GUI&lt;/a&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;a title="Show Abortion in Code" href="adt://NPL/sap/bc/adt/programs/programs/zarc1_e2e_dump/source/main#start=8"&gt;Show Abortion in Code&lt;/a&gt;&lt;/p&gt;&lt;h4 id="OVERVIEW"&gt;Contents&lt;/h4&gt;&lt;a href="#HEADER"&gt;Header Information&lt;/a&gt;&lt;br&gt;&lt;a href="#WHATHAPPENED"&gt;What happened?&lt;/a&gt;&lt;br&gt;&lt;a href="#ERROR"&gt;Error analysis&lt;/a&gt;&lt;br&gt;&lt;a href="#TERMINATION"&gt;Information on where terminated&lt;/a&gt;&lt;br&gt;&lt;a href="#SOURCE"&gt;Source Code Extract&lt;/a&gt;&lt;br&gt;&lt;a href="#STACK"&gt;Active Calls/Events&lt;/a&gt;&lt;h4 id="HEADER"&gt;Header Information&lt;/h4&gt;&lt;table cellspacing="3"&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Short Text&lt;/b&gt;&lt;/td&gt;&lt;td&gt; Division by zero. &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Runtime Error&lt;/b&gt;&lt;/td&gt;&lt;td&gt; COMPUTE_INT_ZERODIVIDE &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Exception&lt;/b&gt;&lt;/td&gt;&lt;td&gt; CX_SY_ZERODIVIDE &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Program&lt;/b&gt;&lt;/td&gt;&lt;td&gt; ZARC1_E2E_DUMP &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Date/Time&lt;/b&gt;&lt;/td&gt;&lt;td&gt; 24.10.2026 09:21:05 (System) &lt;/td&gt;&lt;/tr&gt;&lt;tr&g