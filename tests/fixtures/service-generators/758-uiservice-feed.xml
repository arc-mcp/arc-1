dt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator" type="application/vnd.sap.adt.repository.generator.v1+json"/><atom:summary>Create a SAP Fiori based Table Maintenance app for a Customizing Table</atom:summary><atom:title>Maintenance Object</atom:title></atom:entry><atom:entry><atom:category term="ABAP RESTful Application Programming Model" label="Services of ABAP RESTful Application Programming Model (RAP)."/><atom:content type="application/vnd.sap.adt.repository.generator.v1+json" src="uiservice"/><atom:id>uiservice</atom:id><atom:link href="/sap/bc/adt/businessservices/generators/uiservice/content?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/content" type="application/vnd.sap.adt.repository.generator.content.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/uiservice/schema?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/schema" type="application/vnd.sap.adt.repository.generator.schema.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/uiservice/uiconfig?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/uiconfig" type="application/vnd.sap.adt.repository.generator.uiconfig.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/uiservice/validation?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel&amp;checks=package%2creferencedobject%2cauthorization" rel="http://www.sap.com/adt/repository/generator/validation" type="application/vnd.sap.as+xml;charset=utf-8;dataname=com.sap.adt.StatusMessage"/><atom:link href="/sap/bc/adt/businessservices/generators/uiservice/preview?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/preview" type="application/vnd.sap.adt.repository.generator.preview.v1+xml"/><atom:link href="/sap/bc/adt/businessservices/generators/uiservice?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator" type="application/vnd.sap.adt.repository.generator.v1+json"/><atom:summary> An OData UI service makes it possible to consume a RAP service with a Fiori Elements UI or other UI clients. It creates all UI-specific information that is annotated in the RAP artifacts in the OData service metadata. A UI service can be previewed with the Fiori Elements App Preview in the service binding artifact. &lt;p&gt;This generator creates all the development objects that are relevant for a business object and for a RAP service  on the basis of one database table. The end result is a full-blown RAP UI service.&lt;/p&gt; &lt;p&gt; Specifically, the following objects are created: &lt;/p&gt; &lt;li&gt;CDS view entity&lt;/li&gt;  &lt;li&gt;CDS behavior definition&lt;/li&gt;  &lt;li&gt;ABAP implementation class&lt;/li&gt;  &lt;li&gt;CDS projection view entity&lt;/li&gt;  &lt;li&gt;CDS projection behavior definition&lt;/li&gt;  &lt;li&gt;Draft database table&lt;/li&gt;  &lt;li&gt;Metadata extension&lt;/li&gt;  &lt;li&gt;CDS service definition&lt;/li&gt;  &lt;li&gt;Service binding&lt;/li&gt; </atom:summary><atom:title>OData UI Service</atom:title></atom:entry><atom:entry><atom:category term="ABAP RESTful Application Programming Model" label="Services of ABAP RESTful Application Programming Model (RAP)."/><atom:content type="application/vnd.sap.adt.repository.generator.v1+json" src="webapiservice"/><atom:id>webapiservice</atom:id><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice/content?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/content" type="application/vnd.sap.adt.repository.generator.content.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice/schema?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/schema" type="application/vnd.sap.adt.repository.generator.schema.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice/uiconfig?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/uiconfig" type="application/vnd.sap.adt.repository.generator.uiconfig.v1+json"/><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice/validation?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel&amp;checks=package%2creferencedobject%2cauthorization" rel="http://www.sap.com/adt/repository/generator/validation" type="application/vnd.sap.as+xml;charset=utf-8;dataname=com.sap.adt.StatusMessage"/><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice/preview?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator/preview" type="application/vnd.sap.adt.repository.generator.preview.v1+xml"/><atom:link href="/sap/bc/adt/businessservices/generators/webapiservice?referencedObject=%2fsap%2fbc%2fadt%2fddic%2ftables%2fztravel" rel="http://www.sap.com/adt/repository/generator" type="application/vnd.sap.adt.repository.generator.v1+json"/><atom:summary> An OData service that is exposed as a Web API is used for all other scenarios apart from UIs.  Web APIs can be consumed by any OData client.  A Web API service does not provide any UI-specific information in the service metadata.  &lt;p&gt;This generator creates all the development objects that are relevant for a business object and for a RAP service  on the basis of one database table. The end result is a full-blown RAP Web API service.&lt;/p&gt; &lt;p&gt; Specifically, the following objects are created: &lt;/p&gt; &lt;li&gt;CDS view entity&lt;/li&gt;  &lt;li&gt;CDS behavior definition&lt;/li&gt;  &lt;li&gt;ABAP implementation class&lt;/li&gt;  &lt;li&gt;CDS projection view entity&lt;/li&gt;  &lt;li&gt;CDS projection behavior definition&lt;/li&gt;  &lt;li&gt;CDS service definition&lt;/li&gt;  &lt;li&gt;Service binding&lt;/li&gt; </atom:summary><atom:title>OData Web API Service</atom:title></atom:entry></atom:feed>